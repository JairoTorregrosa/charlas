# API key de Console: https://platform.claude.com/settings/keys
# Una suscripción de claude.ai (Pro o Max) NO sirve aquí: Managed Agents pide
# cuenta de Console, API key y facturación configurada.
# La API key va en el .env de la raíz del kit (../.env.example). También sirve ponerla aquí.
ANTHROPIC_API_KEY=

# Los imprime crear_agente.py
AGENT_ID=
ENVIRONMENT_ID=

# Lo imprime agente_vuelo.py la primera vez
SKILL_ID=
