# La key empieza por sk-ant-. No es el ID (apikey_...) que muestra la tabla de keys.
# Lo que pongas aquí le gana a una ANTHROPIC_API_KEY exportada en tu shell.
ANTHROPIC_API_KEY=

# Pista A: tu copia del repo de práctica y un fine-grained token solo para ese repo.
TALLER_REPO_VULN=
GITHUB_TOKEN=

# Opcional. Sonnet 5.5 rinde los créditos en la Pista B.
# TALLER_MODELO=claude-sonnet-5-5
