async def main() -> None:
    print(f"▶ {{NOMBRE}}\n")
    try:
        async for mensaje in query(prompt=PROMPT, options=opciones):
            imprimir(mensaje)
            imprimir_error_de_tool(mensaje)
    except ClaudeSDKError as error:
        # Tope de vueltas o de gasto, o credencial rechazada: el resultado ya se
        # imprimió arriba; aquí va el motivo, sin traceback.
        print(f"\n⚠️  el agente paró: {error}")
        FALLO[0] = True


if __name__ == "__main__":
    import sys
    if len(sys.argv) > 1:
        PROMPT = " ".join(sys.argv[1:])       # uv run agente.py "tu pregunta"
    preparar_credenciales()                   # ANTES de crear la sesión
    asyncio.run(main())
    sys.exit(1 if FALLO[0] else 0)            # un fallo no se ve como éxito


