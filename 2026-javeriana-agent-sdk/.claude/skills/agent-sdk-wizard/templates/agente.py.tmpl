from claude_agent_sdk import ClaudeSDKClient

import sys

# uv run agente.py "pregunta 1" "pregunta 2" …  — sin argumentos, la prueba del wizard
TURNOS = sys.argv[1:] or [
    "{{PROMPT_PRUEBA}}",
    "{{PROMPT_PRUEBA_2}}",     # este demuestra que se acuerda del anterior
]

async def main() -> None:
    print(f"▶ {{NOMBRE}}\n")
    # Ojo: en una sesión, total_cost_usd del resultado es ACUMULADO (sube de turno en turno).
    async with ClaudeSDKClient(options=opciones) as cliente:
        for turno in TURNOS:
            print(f"\n💬 {turno}")
            await cliente.query(turno)
            async for mensaje in cliente.receive_response():
                imprimir(mensaje)
                imprimir_error_de_tool(mensaje)
