# .env — UNA sola forma de autenticar. Este archivo NUNCA se sube a git.
# AGENTE_AUTH elige cuál; llena SOLO la línea de ese modo.
#
#   ant          → `ant auth login` con el correo de los créditos (recomendado)
#   api_key      → key de platform.claude.com/settings/keys
#   suscripcion  → `claude setup-token` (tu plan Pro/Max; no usa créditos)

AGENTE_AUTH=ant
ANTHROPIC_PROFILE=default
# ANTHROPIC_CONFIG_DIR=          # solo si `ant auth status` muestra otro «Config dir»
# ANTHROPIC_API_KEY=sk-ant-api03-...
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
